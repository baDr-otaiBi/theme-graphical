{#
| Variable                               | Type     | Description |
|----------------------------------------|----------|-------------|
| component.testimonials[].name          | string   |             |
| component.testimonials[].comment       | string   |             |
| component.testimonials[].image         | ?string  |             |
| component.testimonials[].rating        | ?int     |             |
| position                               | int      |             |
#}
{% if component.testimonials|length %}
<section class="s-block container">
    <div class="s-block__title">
        <div class="right-side">
            <h2>{{ trans('blocks.home.testimonials') }}</h2>
        </div>
    </div>
    <salla-slider
        id="custom-testimonials-{{ position }}"
        type="carousel"
        loop="true">
        <div slot="items">
            {% for item in component.testimonials %}
                <div class="slide--one-third">
                    <div class="p-6 h-full" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                        <i class="sicon-quotation-start text-2xl mb-4 block" style="color: var(--graphical-gold); opacity: 0.4;"></i>
                        <p class="text-sm leading-7 mb-4" style="color: var(--graphical-text-muted)">{{ item.comment }}</p>
                        <div class="flex items-center gap-3 pt-4" style="border-top: 1px solid rgba(255,255,255,0.05)">
                            {% if item.image %}
                            <img src="{{ item.image }}" alt="{{ item.name }}" class="w-10 h-10 rounded-full object-cover" style="border: 1px solid var(--graphical-gold-border);">
                            {% endif %}
                            <span class="text-sm font-bold" style="color: var(--graphical-text-primary)">{{ item.name }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
{% endif %}
