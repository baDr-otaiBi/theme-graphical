{#
| Variable                        | Type     | Description  |
|---------------------------------|----------|--------------|
| component                       | object   |              |
| component.photos[]              | object[] |              |
| component.photos[].image        | string   |              |
| component.photos[].title        | ?string  |              |
| component.photos[].link         | ?string  |              |
| component.photos[].description  | ?string  |              |
| position                        | int      |              |
#}
{% if component.photos|length %}
<section class="s-block s-block--banners container">
    <div class="grid grid-cols-2 sm:grid-cols-{{ component.photos|length > 4 ? 4 : component.photos|length }} gap-4 md:gap-5 {{ component.photos|length > 4 ? 'two-row' : '' }}">
        {% for photo in component.photos %}
            <div class="banner-entry square-photos has-overlay" style="background-image:url({{ photo.image }})">
                <article>
                    <a href="{{ photo.link ?: '#' }}" class="absolute inset-0 z-1"></a>
                    <h3 class="{{ photo.title ? 'text-with-border' : '' }}">
                        <span class="font-bold text-sm lg:text-base">{{ photo.title }}</span>
                    </h3>
                    {% if photo.description %}
                        <p class="text-xs mt-2">{{ photo.description }}</p>
                    {% endif %}
                </article>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
