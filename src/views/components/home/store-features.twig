{#
| Variable                 | Type     | Description |
|--------------------------|----------|-------------|
| component                | object   |             |
| component.features       | array    |             |
| component.features[].icon | string  |             |
| component.features[].title | string |             |
| component.features[].description | string |      |
| position                 | int      |             |
#}
{% if component.features|length %}
<section class="s-block s-block--features container">
    <div class="grid grid-cols-2 md:grid-cols-{{ component.features|length > 4 ? 4 : component.features|length }} gap-4 md:gap-6">
        {% for feature in component.features %}
            <div class="s-block--features__item">
                <span class="feature-icon">
                    <i class="{{ feature.icon ?: 'sicon-star' }}"></i>
                </span>
                <h2>{{ feature.title }}</h2>
                <p>{{ feature.description }}</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
