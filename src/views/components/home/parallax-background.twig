{#
| Variable                      | Type     | Description |
|-------------------------------|----------|-------------|
| component                     | object   |             |
| component.image               | string   |             |
| component.title               | ?string  |             |
| component.description         | ?string  |             |
| component.link                | ?string  |             |
| position                      | int      |             |
#}
<section class="s-block s-block--full-bg">
    <div class="full-banner-entry has-overlay" style="background-image:url({{ component.image }})">
        <div class="relative z-1 flex flex-col items-center justify-center h-full">
            {% if component.title %}
                <h2 class="text-2xl lg:text-4xl font-light mb-4" style="letter-spacing: 0.06em; text-transform: uppercase; color: var(--graphical-text-primary)">{{ component.title }}</h2>
            {% endif %}
            {% if component.description %}
                <p class="text-sm lg:text-base max-w-xl mx-auto mb-6" style="color: rgba(255,255,255,0.7)">{{ component.description }}</p>
            {% endif %}
            {% if component.link %}
                <a href="{{ component.link }}" class="inline-block px-8 py-3 text-sm font-bold uppercase tracking-widest" style="border: 1px solid var(--graphical-gold); color: var(--graphical-gold); transition: all 0.3s;" onmouseover="this.style.background='var(--graphical-gold)';this.style.color='var(--graphical-black)'" onmouseout="this.style.background='transparent';this.style.color='var(--graphical-gold)'">
                    {{ trans('common.elements.shop_now') }}
                </a>
            {% endif %}
        </div>
    </div>
</section>
