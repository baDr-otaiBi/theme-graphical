{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
<section class="s-block s-block--hero-slider s-block--full-bg wide-placeholder">
    <salla-slider
      id="main-slider-{{ position }}"
      auto-play
      static-when-single
      slider-config='{"lazy":"false"}'
      {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                <div class="swiper-slide w-full min-h-[400px] lg:min-h-[600px] relative" style="background: var(--graphical-black)">
					<div style="background-image: url({{ slide.image }});" class="{{ slide.without_overlay ? '' : 'overlay-bg' }} bg-cover bg-center absolute inset-0"></div>
                    <div class="flex-center container pb-16 sm:pb-0 home-slider__content relative h-full">
                        <div class="w-5/6 text-center md:w-7/12 lg:w-5/12 text-white">
                            {% if slide.title %}
                            <h2 data-swiper-parallax="-500" class="text-2xl lg:text-4xl xl:text-5xl font-light leading-tight mb-5" style="letter-spacing: 0.06em; text-transform: uppercase;">{{ slide.title }}</h2>
                            {% endif %}
                            {% if slide.description %}
                            <p data-swiper-parallax="-300" class="line-clamp-2 description text-sm lg:text-base" style="color: rgba(255,255,255,0.7); letter-spacing: 0.04em;">{{ slide.description }}</p>
                            {% endif %}
                            {% if slide.link %}
                            <a href="{{ slide.link }}" data-swiper-parallax="-200" class="inline-block mt-8 px-8 py-3 text-sm font-bold uppercase tracking-widest" style="border: 1px solid var(--graphical-gold); color: var(--graphical-gold); transition: all 0.3s ease;" onmouseover="this.style.background='var(--graphical-gold)';this.style.color='var(--graphical-black)'" onmouseout="this.style.background='transparent';this.style.color='var(--graphical-gold)'">
                                {{ trans('common.elements.shop_now') }}
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
