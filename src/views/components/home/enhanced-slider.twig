{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
<section class="s-block s-block--hero-slider s-block--full-bg wide-placeholder">
    <salla-slider
      id="main-slider-{{ position }}"
      auto-play
      static-when-single
      slider-config='{"lazy":"false"}'
      {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                <div class="swiper-slide graphical-slide">
                    {# Background image — dynamic value, inline style OK #}
                    <div style="background-image: url({{ slide.image }});" class="graphical-slide__bg" aria-hidden="true"></div>

                    {# Glass dark overlay #}
                    <div class="graphical-slide__overlay" aria-hidden="true"></div>

                    {# Content #}
                    <div class="flex-center container pb-16 sm:pb-0 home-slider__content graphical-slide__content">
                        <div class="w-5/6 text-center md:w-7/12 lg:w-5/12 text-white">
                            {% if slide.title %}
                            <h2 data-swiper-parallax="-500" class="graphical-slide__title text-2xl lg:text-4xl xl:text-5xl leading-tight mb-5">{{ slide.title }}</h2>
                            {# Gold accent line #}
                            <div data-swiper-parallax="-400" class="graphical-slide__accent"></div>
                            {% endif %}
                            {% if slide.description %}
                            <p data-swiper-parallax="-300" class="graphical-slide__description line-clamp-2 text-sm lg:text-base">{{ slide.description }}</p>
                            {% endif %}
                            {% if slide.link %}
                            <a href="{{ slide.link }}" data-swiper-parallax="-200" class="graphical-slide__cta inline-block mt-8">
                                {{ trans('common.elements.shop_now') }}
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
