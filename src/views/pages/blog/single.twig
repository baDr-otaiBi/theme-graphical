{#
| Variable                | Type           | Description |
|-------------------------|----------------|-------------|
| article.title           | string         |             |
| article.body            | string *HTML   |             |
| article.url             | string         |             |
| article.has_image       | Bool           |             |
| article.image           | object         |             |
| article.created_at      | ?Date          |             |
| article.author.name     | string         |             |
| article.related         | Article[]      |             |
| article.tags            | BlogTag[]      |             |
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container mb-8 sm:mb-24">
        <nav class="breadcrumbs w-full py-5 center-between">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <div class="md:flex items-start">
            <div class="main-content blog-category md:w-96 flex-1 lg:p-8 mb-10 md:mb-0" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                <h1 class="font-bold text-3xl mb-5 leading-10" style="color: var(--graphical-text-primary)">{{ article.title }}</h1>
                <div class="mb-10 inline-flex text-sm rtl:space-x-reverse space-x-5" style="color: var(--graphical-text-muted)">
                    <div class="flex items-center">
                        <i class="sicon-calendar-date rtl:ml-1 ltr:mr-1"></i>
                        <span>{{ article.created_at|date }}</span>
                    </div>
                    <a href="{{ article.author.url }}" class="flex items-center" style="color: var(--graphical-text-muted)">
                        <i class="sicon-user rtl:ml-1 ltr:mr-1"></i>
                        <span>{{ article.author.name }}</span>
                    </a>
                </div>
                {% if article.has_image %}
                    <img src="{{ article.image.url }}" alt="{{ article.image.alt }}" title="{{ article.image.alt }}"
                         class="h-80 mb-10 w-full object-cover" style="border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);"/>
                {% endif %}

                {% if store.settings.blog.allow_likes_and_comments %}
                <div class="flex items-center gap-2.5 text-base mb-2" style="color: var(--graphical-text-muted)">
                    <button id="blog-like" data-blog-id="{{ article.key }}" class="flex items-center gap-1">
                        <i class="sicon-thumbs-up" style="color: var(--graphical-gold)"></i>
                        <span>{{article.likes_count}}</span>
                    </button>
                    {% if article.comments_count %}
                        <div class="flex items-center gap-1">
                            <i class="sicon-chat" style="color: var(--graphical-gold)"></i>
                            {{article.comments_count}}
                        </div>
                    {% endif %}
                </div>
                {% endif %}

                <article class="leading-7 text-sm mb-10 content-entry">{{ article.body|replace({'&nbsp;': ' '})|raw }}</article>
                {% if article.tags|length %}
                    <div class="p-4 flex flex-wrap items-center" style="border-top: 1px solid rgba(255,255,255,0.05)">
                        {% for tag in article.tags %}
                            <a href="{{ tag.url }}"
                               class="py-2 px-4 inline-flex items-center justify-center text-sm" style="color: var(--graphical-text-muted)">
                                <i class="font-medium sicon-tag rtl:ml-1.5 ltr:mr-1.5"></i>
                                <span class="fix-align whitespace-nowrap">{{ tag.name }}</span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if store.settings.blog.allow_likes_and_comments %}
                    <salla-comments item-id="{{article.key}}" type="blog"></salla-comments>
                {% endif %}
            </div>

            <aside aria-label="Sidebar" class="sticky shrink-0 top-24 md:w-96 rtl:lg:mr-8 ltr:lg:ml-8 pb-11">
                {% if related|length %}
                    <h2 class="font-bold mb-3" style="color: var(--graphical-text-primary)">{{ trans('pages.blog_articles.related') }}</h2>
                    {% hook 'blog:single.items.start' %}
                    {% for article in related %}
                        <div class="mt-5 flex items-center p-5" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                            <div class="shrink-0">
                                <a href="{{ article.url }}" class="h-24 w-24 overflow-hidden flex items-center justify-center" style="background: var(--graphical-dark-surface); border-radius: var(--graphical-radius);">
                                    <span class="sr-only">{{ article.name }}</span>
                                    {% if article.has_image %}
                                        <img class="h-full w-full object-cover" src="{{ article.image.url }}" alt="{{ article.image.alt }}">
                                    {% else %}
                                        <img class="sm:h-full w-10 object-contain opacity-60" src="{{ 'images/placeholder.png' | asset }}" alt="post image"/>
                                    {% endif %}
                                </a>
                            </div>
                            <div class="rtl:mr-3 ltr:ml-3">
                                <div class="flex items-center text-sm mb-2" style="color: var(--graphical-text-muted)">
                                    <i class="sicon-calendar-date rtl:ml-1 ltr:mr-1"></i>
                                    <time>{{ article.created_at|date }}</time>
                                </div>
                                <h3 class="text-sm font-bold leading-6">
                                    <a href="{{ article.url }}" class="hover:underline" style="color: var(--graphical-text-primary)">{{ article.title }}</a>
                                </h3>
                            </div>
                        </div>
                    {% endfor %}
                    {% hook 'blog:single.items.end' %}
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
