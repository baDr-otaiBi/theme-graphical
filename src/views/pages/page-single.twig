{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <div class="flex justify-center">
            <div class="content content--single-page w-full lg:w-10/12 p-6 lg:p-8 mt-4 lg:mt-12" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                <h1 class="font-bold text-2xl mb-6" style="color: var(--graphical-text-primary)">{{ page.title }}</h1>
                <div class="content-entry">
                    {{ page.content|raw }}
                </div>
                <salla-comments item-id="{{page.id}}" type="page"></salla-comments>
            </div>
        </div>
    </div>
{% endblock %}
