{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.rating                         | ?Rating                     |                                                                        |
| product.price                          | float                       |                                                                        |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.images                         | array                       |                                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.options                        | ProductOption[]              |                                                                        |
| product.is_on_sale                     | bool                        |                                                                        |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.has_3d_image                   | bool                        |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            {# Product Gallery #}
            <div class="sidebar md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 pb-8 md:pb-16 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider image-slider"
                        type="thumbs"
                        loop="false"
                        auto-height
                        listen-to-thumbnails-option
                        show-thumbs-controls="false">
                    {% if product.promotion_title %}
                        <div class="promotion-title">{{ product.promotion_title }}</div>
                    {% endif %}

                    <salla-button
                            class="btn--wishlist animated sws"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light">
                        <i class="sicon-heart"></i>
                    </salla-button>

                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24" style="background: var(--graphical-dark-card); border: 1px solid var(--graphical-gold-border);">
                            <span class="text-xl leading-none font-bold" style="color: var(--graphical-gold)">{{ product.calories }}</span>
                            <span class="text-xs" style="color: var(--graphical-text-muted)">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images %}
                        <div slot="thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    {% if loop.index < 5 %}
                                        <img src="{{ image.url }}"
                                             loading="eager"
                                             class="object-cover w-full h-full overflow-hidden"
                                             style="background: var(--graphical-dark-surface); border-radius: var(--graphical-radius);"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% else %}
                                        <img src="{{ image.url }}"
                                             loading="lazy"
                                             class="object-cover w-full h-full overflow-hidden"
                                             style="background: var(--graphical-dark-surface); border-radius: var(--graphical-radius);"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            {# Product Info #}
            <div class="main-content md:sticky md:overflow-hidden top-24 w-full md:w-2/4 md:pb-16">

                {% hook 'product:single.description.start' %}

                {% if product.brand.name %}
                    <div class="product-brand mb-5 w-16">
                        <a class="brand-logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            <img width="100%" height="100%" class="max-h-full object-contain"
                                 src="{{ product.brand.logo }}"
                                 title="{{ product.brand.name }}"
                                 alt="{{ product.brand.name }}"
                                 style="filter: brightness(0) invert(1); opacity: 0.7;">
                        </a>
                    </div>
                {% endif %}

                {# Product Name — Jacquemus Serif Bold #}
                <h1 class="text-xl md:text-2xl leading-10 mb-4" style="font-family: var(--font-heading); font-weight: 700; color: #FFFFFF; letter-spacing: -0.01em; line-height: 1.2;">{{ product.name }}</h1>

                {% if product.subtitle %}
                    <h2 class="product-entry__sub-title text-sm leading-6 mb-2.5" style="color: var(--graphical-text-muted); letter-spacing: 0.03em;">
                        {{ product.subtitle }}
                    </h2>
                {% endif %}

                {% if product.rating %}
                    <salla-rating-stars value="{{ product.rating.stars }}"
                                        reviews="{{ product.rating.count }}"></salla-rating-stars>
                {% endif %}

                {% if product.is_taxable %}
                    <small style="color: var(--graphical-text-muted)">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}

                {# Price — quiet and minimal #}
                <div class="flex whitespace-nowrap gap-4 items-center mt-2 mb-8 py-4" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                  <div class="{{ product.is_on_sale ? '' : 'hidden' }} space-x-2 rtl:space-x-reverse whitespace-nowrap">
                      <p class="font-light text-lg inline-block" style="color: rgba(255,255,255,0.6);">{{product.sale_price|money}}</p>
                      <span class="line-through text-base" style="color: rgba(255,255,255,0.25)">{{product.regular_price|money}}</span>
                  </div>
                  <div class="gap-4 {{ product.is_on_sale ? 'hidden' : 'flex' }} items-baseline">
                      {% if product.starting_price %}
                          <span class="text-sm" style="color: rgba(255,255,255,0.4)">{{ trans('pages.products.starting_price') }}</span>
                      {% endif %}
                          <p class="font-light text-lg inline-block" style="color: rgba(255,255,255,0.6);"> {{product.starting_price ? product.starting_price|money : product.price|money }}</p>
                  </div>
                </div>

                {# Description — with proper formatting #}
                <div class="product__description graphical-rich-content py-4 leading-7 mb-4">
                    {% set product_desc = product.description %}
                    {% if product.has_read_more %}
                        <article class="article article--main relative leading-8 overflow-hidden transition-all max-h-0 duration-300"
                            id="more-content" style="max-height:5.25rem;">
                            {{ product_desc|raw }}
                        </article>
                        <a id="btn-show-more" class="link--primary inline-block mt-2 cursor-pointer">
                            {{ trans('pages.products.read_more') }}
                        </a>
                    {% else %}
                        <article class="article--main pb-1">
                            {{ product_desc|raw }}
                        </article>
                    {% endif %}
                </div>

                {# Tags — styled as elegant pills #}
                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                    <div class="mb-4 flex flex-wrap gap-2">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}"
                               class="inline-flex text-xs px-3 py-1" style="color: var(--graphical-gold); border: 1px solid var(--graphical-gold-border); border-radius: 2px; letter-spacing: 0.04em; transition: all 0.3s ease;">{{ tag.name }}</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Actions — wishlist + share with luxury styling #}
                <div class="flex rtl:space-x-reverse space-x-3 mb-2">
                    <salla-social-share class="inline-flex mb-5" aria-label="social share"></salla-social-share>
                    <salla-button
                            class="btn--wishlist animated hidden sm:inline-flex"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light"
                            aria-label="add to wishlist">
                        <i class="sicon-heart"></i>
                    </salla-button>
                </div>

                {% if product.sold_quantity or product.can_show_remained_quantity %}
                    <div class="py-2.5 mb-5 inline-flex text-sm" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                        {% if product.sold_quantity %}
                            <div class="px-4" style="color: var(--graphical-gold)">
                                <i class="sicon-fire rtl:ml-1.5 ltr:mr-1.5"></i> {{ trans('pages.products.sold') }}
                                <span>{{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            </div>
                        {% endif %}
                        {% if product.can_show_remained_quantity %}
                            <div class="px-4 rtl:even:border-r ltr:even:border-l" style="border-color: rgba(255,255,255,0.05)">
                                <i class="sicon-box-bankers rtl:ml-1.5 ltr:mr-1.5" style="color: var(--graphical-gold)"></i>
                                {{ trans('pages.products.remained') }}
                                <span>{{ product.quantity }}</span>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if product.sku %}
                    <div class="mb-4 flex items-center justify-between px-4 py-3" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                        <div class="flex items-center gap-2" style="color: var(--graphical-text-muted); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;">
                            <i class="sicon-barcode" style="color: var(--graphical-gold);"></i>
                            {{ trans('pages.products.sku') }}
                        </div>
                        <div class="text-unicode" style="color: var(--graphical-text-secondary); font-size: 0.85rem; font-family: monospace; letter-spacing: 0.1em;">{{ product.sku }}</div>
                    </div>
                {% endif %}

                {% hook 'product:single.description' %}

                <salla-installment price="{{ product.price }}"></salla-installment>
                {% if product.has_metadata %}
                <salla-metadata></salla-metadata>
                {% endif %}

                {% if product.show_availability %}
                    <section class="p-5 mb-5 last:mb-0" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <a href="#!"
                                   onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                   class="group flex items-center justify-center" style="color: var(--graphical-gold)">
                                    <span>{{ trans('pages.products.select_branch') }}</span>
                                    <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                </a>
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% if product.digital_files_settings %}
                    <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                {% endif %}

                <form class="form product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">

                    {% hook 'product:single.form.start' %}
                    {% include 'pages.partials.product.options' %}
                    {% hook 'product:single.form.end' %}

                    <section class="flex p-5 sm:pb-0" style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius) var(--graphical-radius) 0 0;">
                        <div class="center-between w-full">
                            <label class="form-label">
                                <b class="block" style="color: var(--graphical-text-primary)">
                                    {{ trans('pages.products.price') }}
                                </b>
                            </label>
                            <div class="flex whitespace-nowrap price-wrapper gap-4 items-center">
                              <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale space-x-2 rtl:space-x-reverse whitespace-nowrap">
                                <h2 class="total-price font-bold text-xl inline-block" style="color: var(--graphical-gold)">{{product.sale_price|money}}</h2>
                                <span class="before-price line-through" style="color: var(--graphical-text-muted)">{{product.regular_price|money}}</span>
                              </div>
                              <div class="starting-or-normal-price gap-4 {{ product.is_on_sale ? 'hidden' : 'flex' }}">
                                {% if product.starting_price %}
                                  <span class="starting-price-title" style="color: var(--graphical-text-muted)">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                <h2 class="total-price font-bold text-xl inline-block" style="color: var(--graphical-gold)"> {{product.starting_price ? product.starting_price|money : product.price|money }}</h2>
                              </div>
                            </div>
                            <div class="out-of-stock min-h-7 leading-7 hidden text-base !opacity-50 font-bold" style="color: #ef4444">{{ trans('pages.products.out_of_stock')}}</div>
                        </div>
                    </section>

                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    <section class="sticky-product-bar p-5">
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                        {% else %}
                            <div class="sticky-product-bar__quantity center-between mb-5">
                                <label class="form-label font-bold" style="color: var(--graphical-text-primary)">
                                    {{ trans('pages.products.quantity') }}
                                </label>
                                <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                  class="flex justify-end" style="border-color: rgba(255,255,255,0.08);"></salla-quantity-input>
                            </div>
                        {% endif %}

                        <salla-add-product-button
                                {{product.can_quick_buy ? 'quick-buy' : ''}}
                                {{theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : ''}}
                                {{product.is_require_shipping ? 'required-shipping' : ''}}
                                {{product.has_preorder_campaign ? 'has-pre-order' : ''}}
                                amount="{{ product.base_currency_price }}"
                                class="mt-5 w-full sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>
                            {{ product.add_to_cart_label }}
                        </salla-add-product-button>
                    </section>

                    {% if product.is_giftable %}
                        <salla-gifting class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : ''  }}></salla-gifting>
                    {% endif %}
                </form>

                {% hook 'product:single.description.end' %}
                <salla-quick-order class="mt-5 md:-mb-2 block"></salla-quick-order>
            </div>
        </div>
        <salla-offer></salla-offer>
    </div>

    {% if store.settings.rating.show_on_product %}
        <salla-comments item-id="{{product.id}}" type="product"></salla-comments>
    {% endif %}

    <div class="container">
        <salla-products-slider source="related" source-value="{{product.id}}" block-title="{{trans('pages.products.similar_products')}}" display-all-url></salla-products-slider>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}
