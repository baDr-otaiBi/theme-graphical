{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ user.language.code }}" dir="{{ user.language.dir }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}

    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
    </script>

    {# === Salla hooks — let Salla inject its base CSS === #}
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}

    {# === 1. Fonts FIRST — preconnect early to prevent FOUT === #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Cairo:wght@300;400;600&display=swap" rel="stylesheet">

    {# === 2. Salla base stylesheets === #}
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>

    {# === 3. Theme stylesheet — AFTER Salla base so we override === #}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">

    {# === 4. Critical CSS — before Salla's end hook === #}
    <style>
        :root {
            --font-heading: 'Playfair Display', 'Cairo', serif;
            --font-body: 'Cairo', sans-serif;
            --font-main: var(--font-body);
            --graphical-gold: #D4AF37;
            --graphical-gold-light: #E5C84D;
            --graphical-gold-dark: #B8941F;
            --graphical-black: #0A0A0A;
            --graphical-dark-surface: #141414;
            --graphical-dark-card: #1A1A1A;
            --graphical-dark-elevated: #222222;
            --graphical-text-primary: #F5F5F5;
            --graphical-text-secondary: #B0B0B0;
            --graphical-text-muted: #707070;
            --graphical-gold-border: rgba(212, 175, 55, 0.15);
            --graphical-gold-muted: rgba(212, 175, 55, 0.10);
            --graphical-radius: 0px;
        }
        html, body, #app { background-color: #0A0A0A; color: rgba(255,255,255,0.7); font-family: var(--font-body); font-weight: 300; }
    </style>
    {% hook 'head:end' %}

    {# === 5. FINAL override — Jacquemus Dark Luxury — AFTER all Salla hooks === #}
    <style>
        /* ===== COLOR PRIMARY FORCE ===== */
        :root, html, body, body.theme-graphical {
            --color-primary: #D4AF37 !important;
            --color-primary-dark: #B8941F !important;
            --color-primary-light: #E5C84D !important;
            --color-primary-reverse: #000000 !important;
            --color-text: #F5F5F5 !important;
        }

        /* ===== TYPOGRAPHY — Jacquemus Style ===== */
        h1, h2, h3 {
            font-family: 'Playfair Display', 'Cairo', serif !important;
            font-weight: 900;
            letter-spacing: -0.01em;
            line-height: 1.1;
            color: #FFFFFF;
        }
        h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
        h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }
        h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); }

        /* ===== TAILWIND UTILITY NUCLEAR OVERRIDES ===== */
        .bg-white { background-color: transparent !important; }
        .bg-gray-50 { background-color: transparent !important; }
        .bg-gray-100 { background-color: transparent !important; }
        .bg-gray-200 { background-color: transparent !important; }
        .bg-gray-300 { background-color: transparent !important; }
        .text-gray-900, .text-gray-800 { color: #F5F5F5 !important; }
        .text-gray-700, .text-gray-600 { color: rgba(255,255,255,0.5) !important; }
        .text-gray-500 { color: rgba(255,255,255,0.4) !important; }
        .text-black { color: #F5F5F5 !important; }
        .border-gray-100, .border-gray-200, .border-gray-300 {
            border-color: rgba(255,255,255,0.06) !important;
        }
        .divide-gray-100 > :not([hidden]) ~ :not([hidden]),
        .divide-gray-200 > :not([hidden]) ~ :not([hidden]) {
            border-color: rgba(255,255,255,0.06) !important;
        }
        .s-block--full-bg { background-color: transparent !important; }

        /* ===== PRODUCT CARDS — Jacquemus Minimal ===== */
        custom-salla-product-card, salla-product-card, .s-product-card-entry {
            background: transparent !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            overflow: hidden;
        }
        custom-salla-product-card:hover, .s-product-card-entry:hover {
            border-color: transparent !important;
            box-shadow: none !important;
        }
        .s-product-card-image {
            background: #111 !important;
            position: relative;
            overflow: hidden;
            aspect-ratio: 3/4;
        }
        .s-product-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .s-product-card-image::after { display: none !important; }
        .s-product-card-entry:hover .s-product-card-image img,
        custom-salla-product-card:hover .s-product-card-image img {
            transform: scale(1.03);
        }
        .s-product-card-content {
            background: transparent !important;
            padding: 16px 4px 24px !important;
        }
        .s-product-card-content-title a {
            font-family: 'Playfair Display', 'Cairo', serif !important;
            font-weight: 400 !important;
            font-size: 15px !important;
            color: #FFFFFF !important;
            text-decoration: none;
            letter-spacing: 0.01em;
            line-height: 1.3;
        }
        .s-product-card-entry:hover .s-product-card-content-title a,
        custom-salla-product-card:hover .s-product-card-content-title a {
            color: rgba(255,255,255,0.6) !important;
        }
        .s-product-card-price, .s-product-card-sale-price h4,
        .s-product-card-starting-price h4 {
            font-family: 'Cairo', sans-serif !important;
            font-size: 13px !important;
            font-weight: 300 !important;
            color: rgba(255,255,255,0.5) !important;
        }
        .s-product-card-sale-price span,
        .s-product-card-price del { color: rgba(255,255,255,0.25) !important; }
        .s-product-card-promotion-title { display: none !important; }
        .s-product-card-rating { display: none !important; }
        .s-product-card-content-subtitle { display: none !important; }
        .s-product-card-content-footer,
        .s-product-card-content-footer salla-add-product-button,
        custom-salla-product-card salla-add-product-button { display: none !important; }

        /* Wishlist — hidden, appears on hover */
        .s-product-card-wishlist-btn {
            background: transparent !important;
            border: none !important;
            color: #FFFFFF !important;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        custom-salla-product-card:hover .s-product-card-wishlist-btn,
        .s-product-card-entry:hover .s-product-card-wishlist-btn {
            opacity: 0.6;
        }
        .s-product-card-wishlist-btn:hover,
        .s-product-card-wishlist-added {
            opacity: 1 !important;
            color: #FFFFFF !important;
            background: transparent !important;
        }

        /* ===== PRODUCTS GRID — 2 columns ===== */
        .s-products-grid, .products-grid, [class*="products-grid"] {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 2px !important;
            padding: 0 !important;
        }
        @media (max-width: 768px) {
            .s-products-grid, .products-grid, [class*="products-grid"] {
                grid-template-columns: 1fr 1fr !important;
                gap: 1px !important;
            }
        }

        /* ===== PRODUCT OPTIONS DROPDOWN — DARK ===== */
        salla-product-options select,
        salla-product-options .s-form-control,
        .s-form-control, .form-control,
        .s-product-options-wrapper select,
        .s-product-options-container select,
        .s-product-option select {
            background: #111 !important;
            color: #F5F5F5 !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            border-radius: 0 !important;
            padding: 12px 16px;
            font-size: 14px;
            appearance: none;
        }
        salla-product-options select option {
            background: #111;
            color: #F5F5F5;
        }
        salla-product-options label,
        .s-product-option-label {
            color: rgba(255,255,255,0.5) !important;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        /* ===== RICH CONTENT (Product Description) ===== */
        .graphical-rich-content {
            color: rgba(255,255,255,0.8);
            line-height: 1.9;
            font-size: 15px;
        }
        .graphical-rich-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 24px 0;
        }
        .graphical-rich-content table td,
        .graphical-rich-content table th {
            padding: 10px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            text-align: right;
            white-space: nowrap;
        }
        .graphical-rich-content table th {
            color: rgba(255,255,255,0.5);
            font-weight: 400;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .graphical-rich-content p { margin-bottom: 1.2em; }
        .graphical-rich-content img { max-width: 100%; height: auto; }

        /* ===== SECTION TITLES — Jacquemus Bold ===== */
        .s-block__title h2, .s-block-title, [class*="block-title"], .section-title {
            font-family: 'Playfair Display', 'Cairo', serif !important;
            font-weight: 900 !important;
            font-size: clamp(1.8rem, 4vw, 3rem) !important;
            color: #FFFFFF !important;
            text-align: right !important;
            padding: 48px 0 32px !important;
            letter-spacing: -0.02em;
        }
        .s-block__title h2::after { display: none !important; }

        /* ===== NAVIGATION — Jacquemus clean ===== */
        .main-menu > li > a {
            font-family: 'Cairo', sans-serif !important;
            font-size: 13px !important;
            font-weight: 400 !important;
            color: rgba(255,255,255,0.6) !important;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .main-menu > li > a:hover,
        .main-menu > li.is-active > a {
            color: #FFFFFF !important;
        }

        /* ===== HEADER ICONS — bare, no circles ===== */
        .header-btn__icon {
            background: transparent !important;
            border: none !important;
            color: #FFFFFF !important;
            font-size: 20px;
            border-radius: 0 !important;
            width: auto !important;
            height: auto !important;
            padding: 8px;
        }
        .header-btn__icon:hover { opacity: 0.6; transform: none !important; }

        /* ===== LOGO — bigger ===== */
        .navbar-brand img { max-height: 48px !important; }

        /* ===== SPACING — generous ===== */
        .s-block, [class*="s-block"], section[class*="block"] {
            padding: 80px 0 !important;
            background: transparent !important;
            border: none !important;
        }
        @media (max-width: 768px) {
            .s-block, [class*="s-block"], section[class*="block"] {
                padding: 48px 0 !important;
            }
        }
        .container, .s-container {
            max-width: 1240px;
            padding-inline: 24px;
        }

        /* ===== BUTTONS — Jacquemus white on black ===== */
        salla-add-product-button .s-button-element,
        .s-button-primary, .s-btn-primary, .btn-primary,
        .btn--primary, .btn--default {
            background: #FFFFFF !important;
            color: #000000 !important;
            border: none !important;
            border-radius: 0 !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            letter-spacing: 0.12em !important;
            text-transform: uppercase !important;
            padding: 16px 48px !important;
            transition: opacity 0.3s ease;
            box-shadow: none !important;
        }
        salla-add-product-button .s-button-element:hover,
        .s-button-primary:hover, .s-btn-primary:hover, .btn-primary:hover,
        .btn--primary:hover, .btn--default:hover {
            opacity: 0.7;
            background: #FFFFFF !important;
            color: #000000 !important;
        }
        .btn--outline, .btn--outline-primary, .s-btn-outline, .btn-outline {
            background: transparent !important;
            color: #FFFFFF !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            border-radius: 0 !important;
            font-size: 12px !important;
            letter-spacing: 0.12em !important;
            text-transform: uppercase;
            padding: 16px 48px !important;
        }
        .btn--outline:hover, .btn--outline-primary:hover,
        .s-btn-outline:hover, .btn-outline:hover {
            border-color: #FFFFFF !important;
            background: transparent !important;
            color: #FFFFFF !important;
        }

        /* ===== SLIDER CONTROLS — minimal ===== */
        .swiper-button-prev, .swiper-button-next {
            background: transparent !important;
            border: 1px solid rgba(255,255,255,0.2) !important;
            color: #FFFFFF !important;
            width: 40px !important;
            height: 40px !important;
            border-radius: 0 !important;
        }
        .swiper-button-prev:hover, .swiper-button-next:hover {
            border-color: #FFFFFF !important;
        }
        .swiper-button-prev::after, .swiper-button-next::after {
            font-size: 14px !important;
        }

        /* ===== FOOTER — Jacquemus clean ===== */
        footer, .s-footer, .store-footer, .store-footer__inner {
            background: #000 !important;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .store-footer h3, .store-footer h4, .footer-title {
            font-size: 11px !important;
            font-weight: 600 !important;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255,255,255,0.4) !important;
        }
        .store-footer h3::after { display: none !important; }
        .store-footer a {
            font-size: 13px;
            color: rgba(255,255,255,0.6) !important;
        }
        .store-footer a:hover { color: #FFFFFF !important; }

        /* ===== PRODUCT PAGE ===== */
        .s-product-title, .product-title {
            font-family: 'Playfair Display', 'Cairo', serif !important;
            font-weight: 700;
            font-size: 28px;
            color: #FFFFFF;
        }

        /* ===== SEARCH DARK ===== */
        .s-search-container, .s-search-wrapper,
        [class*="search-modal"], [class*="search-content"] {
            background: #0A0A0A !important;
            color: #F5F5F5 !important;
        }
        .s-search-input, [class*="search"] input[type="search"],
        [class*="search"] input[type="text"] {
            background: #141414 !important;
            color: #F5F5F5 !important;
            border-color: rgba(255,255,255,0.08) !important;
        }

        /* ===== MODAL DARK ===== */
        .s-modal-content, .s-login-wrapper,
        [class*="modal-content"], .s-bottom-alert-content,
        [class*="sheet-content"] {
            background: #1A1A1A !important;
            color: #F5F5F5 !important;
        }

        /* ===== FOCUS STATES ===== */
        *:focus-visible {
            outline: 2px solid rgba(255,255,255,0.3) !important;
            outline-offset: 2px !important;
        }
        input:focus, select:focus, textarea:focus {
            border-color: rgba(255,255,255,0.3) !important;
            box-shadow: none !important;
        }

        /* ===== KILL ALL DECORATIVE EFFECTS ===== */
        * { box-shadow: none; }
    </style>
</head>
<body id="app" class="theme-graphical overflow-x-hidden topnav-is-dark
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main">
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal></salla-offer-modal>
<salla-search></salla-search>

{% if user.type=='guest' %}
    <salla-login-modal></salla-login-modal>
{% endif %}
{% if store.scope %}
    <salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
