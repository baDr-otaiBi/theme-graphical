{% extends "layouts.master" %}
{% block content %}
    <div class="profile-header gradient-bg" style="border-bottom: 1px solid var(--graphical-gold-border);">
        <div class="container relative flex justify-between h-full items-center">
            <nav class="breadcrumbs w-full py-5 self-start">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        </div>
    </div>
    <div class="container lg:mb-24">
        <div class="flex items-start flex-col lg:flex-row justify-center">
            {% if user.type == 'user' %}
                <nav aria-label="Sidebar"
                    class="shrink-0 lg:sticky top-24 lg:-mt-28 w-full lg:w-72 rtl:lg:ml-8 ltr:lg:mr-8 lg:pt-8 lg:pb-11 sidebar space-y-px"
                    style="background: var(--graphical-dark-card); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--graphical-radius);">

                    {% if is_page('customer.profile') %}
                        <div class="text-center md:mb-9">
                            <div class="h-20 w-20 m-auto avatar-wrap rounded-full" style="background: var(--graphical-dark-surface); border: 2px solid var(--graphical-gold-border);">
                                <salla-file-upload profile-image value="{{ user.avatar }}">
                                    <span class='avatar-placeholder flex justify-center items-center flex-col'>
                                        <span class='sicon-user'></span>
                                        <span class='text'>{{ trans('common.uploader.choose_suitable_picture') }}</span>
                                    </span>
                                </salla-file-upload>
                            </div>
                        </div>
                    {% endif %}

                    <div class="hidden lg:block">
                        <salla-user-menu inline></salla-user-menu>
                    </div>
                </nav>
            {% endif %}
            <div class="main-content w-full flex-1 lg:pt-10 max-w-3xl">
                {% block inner_title %}
                    <h1 class="font-bold text-lg text-center sm:rtl:text-right sm:ltr:text-left mb-2" style="color: var(--graphical-text-primary)">{{ page.title }}</h1>
                {% endblock %}
                {% block inner_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
